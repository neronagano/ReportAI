# Local development only. Docker Compose overrides connection hostnames inside containers.
APP_ENV=development
APP_SECRET_KEY=development-change-me-9c1e02a4b683d75f
LOG_LEVEL=INFO
ALLOWED_HOSTS=["localhost","127.0.0.1","api","testserver"]
CORS_ORIGINS=[]
TOKEN_TTL_MINUTES=30
LOGIN_REQUESTS_PER_MINUTE=20

POSTGRES_USER=shiftledger
POSTGRES_PASSWORD=shiftledger-local-postgres
POSTGRES_DB=shiftledger
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://shiftledger:shiftledger-local-postgres@127.0.0.1:15432/shiftledger
REDIS_PASSWORD=shiftledger-local-redis
REDIS_PORT=16379
REDIS_URL=redis://:shiftledger-local-redis@127.0.0.1:16379/0

KAFKA_PORT=19092
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC_PARTITIONS=3
KAFKA_REPLICATION_FACTOR=1

S3_PORT=18333
S3_ENDPOINT_URL=http://127.0.0.1:18333
S3_ACCESS_KEY_ID=shiftledger-local
S3_SECRET_ACCESS_KEY=shiftledger-local-storage-secret
S3_BUCKET=shiftledger-receipts
S3_REGION=us-east-1
API_PORT=18000

SEED_ADMIN_PASSWORD=Demo-admin-2026!
SEED_EMPLOYEE_PASSWORD=Demo-employee-2026!

# Required only for a production environment. Set a separate random metrics credential.
# METRICS_TOKEN=
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CAFILE=/run/secrets/kafka-ca.pem
